DB_HOST=""
DB_USER=""
DB_PASS=""
DB_NAME="wikipi"
JWT_KEY="changeme"
JWT_EXPIRES_IN="1h"
PORT=3000
# Adresse(s) du frontend autorisées (CORS), séparées par des virgules.
# La première sert aussi aux liens envoyés par email.
FRONTEND_URL="http://localhost:5173"

# Envoi d'emails (mot de passe oublié). Sans SMTP_HOST, le lien est affiché
# dans la console du serveur (pratique en développement).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="WikiPi <no-reply@wikipi.local>"
